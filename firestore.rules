rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "melsaembem@gmail.com" && request.auth.token.email_verified == true
      );
    }

    // --- Users ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber']) &&
             data.uid == request.auth.uid &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'userType']);
    }

    // --- Businesses ---
    function isValidBusiness(data) {
      return data.keys().hasAll(['name', 'category', 'ownerId', 'whatsapp']) &&
             data.name is string && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             data.whatsapp is string && data.whatsapp.size() <= 20;
    }

    match /businesses/{businessId} {
      allow read: if true; // Public catalog
      allow create: if isSignedIn() && isValidBusiness(incoming());
      allow update: if (isOwner(existing().ownerId) || isAdmin()) && 
                    isValidBusiness(incoming()) &&
                    incoming().ownerId == existing().ownerId; // ownerId is immutable
      allow delete: if (isOwner(existing().ownerId) || isAdmin());
    }

    // --- Promos ---
    function isValidPromo(data) {
      return data.keys().hasAll(['businessId', 'content', 'expiresAt']) &&
             data.content is string && data.content.size() <= 500 &&
             exists(/databases/$(database)/documents/businesses/$(data.businessId));
    }

    match /businesses/{businessId}/promos/{promoId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId) && isValidPromo(incoming());
      allow update: if isSignedIn() && isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId) && isValidPromo(incoming());
      allow delete: if isSignedIn() && isOwner(get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId);
    }

    // --- Reviews ---
    function isValidReview(data) {
      return data.keys().hasAll(['businessId', 'userId', 'rating']) &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             exists(/databases/$(database)/documents/businesses/$(data.businessId));
    }

    match /businesses/{businessId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update: if isOwner(existing().userId) && isValidReview(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating']);
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
